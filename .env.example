# Copy to .env, fill in real values, chmod 600 it. Never commit .env.

MEGA_CAMERA_PATH=/Camera Uploads
MEGA_KEEPERS_PATH=/Camera Uploads/keepers

# Keep this OUTSIDE MEGA_CAMERA_PATH. Job B moves originals here, and a
# trash folder nested inside the scanned tree is invisible to discovery
# only because mega.list() happens not to recurse today. If recursion is
# ever added, every trashed original is rediscovered at its new path,
# earns a new file_id, and gets re-processed from scratch. slimstream
# warns at startup if you nest it.
MEGA_TRASH_PATH=/slimstream-trash

# Compressed copies land here, mirroring MEGA_CAMERA_PATH's structure and
# filenames under a separate root — never back into MEGA_CAMERA_PATH next
# to the original. Two reasons: (1) browsable — same folder layout and
# names as your camera roll, just compressed, so it's easy to find things;
# (2) resilience — "is this file already compressed?" becomes a plain
# stat() against a predictable path, true even if the manifest sqlite db
# is lost/reset. Must differ from MEGA_CAMERA_PATH (enforced at startup).
MEGA_COMPRESSED_ROOT=/Camera Uploads Compressed

RETENTION_DAYS=30
RETENTION_RUN_DAY=30
# discovered_at, not captured_at: A3 found Mega's timestamp is upload
# time, not EXIF capture date (see IMPLEMENTATION_GUIDE.md Phase 0)
RETENTION_KEY=discovered_at

VIDEO_HEIGHT=480
VIDEO_CRF=30
# 1200, not spec 1.9's original 1600: tuned by eyeballing real photos
# through the sweep in scripts/tune_transcode.py (2026-08-18) — 1200px
# looked decent and saves more.
IMAGE_LONG_EDGE=1200
IMAGE_QUALITY=60

SCRATCH_DIR=/home/slimstream/slimstream/scratch
MANIFEST_DB_PATH=/home/slimstream/slimstream/manifest.db

# Defaults to <MANIFEST_DB_PATH's dir>/logs if unset. Two files land here:
#   slimstream.log — full verbose log, tail -f while a run is in progress
#   runs.log       — one line per invocation (params + outcome), tail this
#                    for a fast human-readable history across past runs
LOG_DIR=/home/slimstream/slimstream/logs

SETTLING_MINUTES=15

# Two independent dry-run gates, not one. Uploading a compressed copy is
# fully reversible (just an extra file in Mega you can inspect before
# trusting it) — deleting an original is the one irreversible action in
# this whole pipeline. Recommended rollout: flip DRY_RUN_UPLOAD to false
# first, review the compressed copies Job A actually uploads, and only
# once you trust that, flip DRY_RUN_DELETE to false too.
DRY_RUN_UPLOAD=true
DRY_RUN_DELETE=true

# Caps how many files Job A actually compresses/uploads per run — NOT how
# many it discovers (discovery always lists the full remote folder, so the
# manifest stays a complete picture of reality). get_pending() orders
# oldest discovered_at first, so a capped run works through backlog oldest
# first and catches up towards the present over successive daily runs.
# 100 is the intended steady-state default; lower it for a first run on a
# large real library.
MAX_BATCH_SIZE=100
