# Copy to .env, fill in real values, chmod 600 it. Never commit .env.

MEGA_CAMERA_PATH=/Camera Uploads
MEGA_KEEPERS_PATH=/Camera Uploads/keepers
MEGA_TRASH_PATH=/slimstream-trash

RETENTION_DAYS=30
RETENTION_RUN_DAY=30
# discovered_at, not captured_at: A3 found Mega's timestamp is upload
# time, not EXIF capture date (see IMPLEMENTATION_GUIDE.md Phase 0)
RETENTION_KEY=discovered_at

VIDEO_HEIGHT=480
VIDEO_CRF=30
# 1200, not spec 1.9's original 1600: tuned by eyeballing real photos
# through the sweep in scripts/tune_transcode.py (2026-08-18) — 1200px
# looked decent and saves more.
IMAGE_LONG_EDGE=1200
IMAGE_QUALITY=60

SCRATCH_DIR=/home/slimstream/slimstream/scratch
MANIFEST_DB_PATH=/home/slimstream/slimstream/manifest.db

SETTLING_MINUTES=15
DRY_RUN=true
